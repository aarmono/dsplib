class LowPassFIR<float> size 0x8 cxx P03_LowPassFIR mirror LpfObj
  0x00 ptr-to-heap coef_         # n_ floats (designed in place from the window; ADOPTED window pointers are owned too)
  0x04 u32 n_

class Psd size 0x10 cxx P03_Psd mirror PsdObj
  0x00 u32 size_                 # segment length N
  0x04 u32 overlap_
  0x08 ptr-to-heap window_       # N floats
  0x0c ptr-to-heap buf_          # N + 1 floats (1-based FFT buffer)

class Agc<float> size 0x20 cxx P03_Agc mirror AgcObj
  0x00 float32 mix_              # weight of the previous gain; 1.0 = frozen
  0x04 float32 mixSaved_
  0x08 float32 gain_
  0x0c float32 target_           # target mean power (1.0)
  0x10 float32 power_            # last measured mean power
  0x14 float32 acc_              # running sum of squares of the current period
  0x18 u32 period_               # samples per measurement (500)
  0x1c u32 count_                # samples left in the period

class SineWave<float,float> size 0x10 cxx P03_SineWave mirror SineObj
  0x00 float32 amp_
  0x04 float32 freq_
  0x08 float32 phase_
  0x0c float32 fs_
