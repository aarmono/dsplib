# The layout of the V.34 module object `tagV34Object` (hand-maintained; it WAS generated by `tier_rewrite.py split` from test/v34/v01.layout, a command that is gone).  test/v34/v01.layout is the layout the C++ ports and the
# blob-vs-port harnesses use (its unknown regions are addressed BY NAME in src/v34/handshake/*.cpp); THIS file is the same object with the unknown regions that the plain-C V.34 tiers
# access by byte offset split into typed members (a new member is cut out of an unknown region with tools/split_region.py).
# V01 layout (32-bit, measured from the blob): the SHARED V.34 module object `tagV34Object` (0xac4c B: VPcmV34Create memsets it) as far as the V.34 chain is ported to named members, plus the two small
# foreign blocks V01 reads: the dp parameter block P = *(obj+0xac3c) (the same blob object as P07's `_tagModemParameters`; V01 names five words inside P07's unknown regions, +0x30 / +0x34 / +0x60 /
# +0x64 / +0x68) and the K56Flex handle *(obj+0xac18) (K56FLEX_Create: UNINITIALISED sysdep_malloc(0x14)).  V01 touches 33 members of the object (V34SetINFO1aBits + VPcmV34InitiateRetrain; the
# resetRetrainDetector record at +0xac1c is flattened, rd<off>_ = retrain_.<member>).  EVERYTHING ELSE is a byte region `unk<off>_`: V02 .. V07 EXTEND this file and src/v34/v34_object.h by SPLITTING
# an unknown region (replace `unk<off>_ <n>` by the named members + the shorter remaining regions in BOTH files; tools/layout_gen.py refuses a layout whose offsets / size are not the i386 ones).
# Earlier V.34 chunks (tiers 2 - 10a) still reach the object by byte offsets and 32-bit pointer slots; on x86-64 only the members named here move (the three pointer slots add 4 bytes each).
# member_map-funcs: tagV34Object = ^(VPcmV34Create|V34SetINFO1aBits|VPcmV34InitiateRetrain|v90Phase34|k56FlexPhase34|v90RateReneg|v90RateRenegSilence|V34GiveINFO1dBits|indicateJaTransmission|VPcmV34GetCurrentRxBitRate|VPcmV34InitMOH|VPcmV34SetMinMaxBitRates|VPcmV34SetDelays|VPcmV34GetVisualDiagnostics|VPcmV34GetDiagnostics|datapumpv34|VPcmV34Progress)(\(.*\))?$
# member_map-funcs: _tagModemParameters deref=0xac3c = ^(VPcmV34Create|V34SetINFO1aBits|VPcmV34InitiateRetrain|v90Phase34|v90RateRenegSilence|V34GiveINFO1dBits|VPcmV34InitMOH|VPcmV34SetMinMaxBitRates|VPcmV34SetDelays|VPcmV34Progress)(\(.*\))?$
# member_map-funcs: K56FlexHandle deref=0xac18 = ^(VPcmV34Create|V34SetINFO1aBits|VPcmV34InitiateRetrain|k56FlexPhase34|indicateJaTransmission|VPcmV34GetCurrentRxBitRate|VPcmV34SetMinMaxBitRates|VPcmV34GetVisualDiagnostics|VPcmV34Progress)(\(.*\))?$
# NOT an input of layout_gen.py: this file is read by tools/gen_views.sh (v34_object_view.h, v34_subobjects.h, v34objmap.h ...).  The generator line of the separate v01 mirror (test/v34/v01.layout) is: tools/layout_gen.py test/v34/v01.layout --chunk v01 --out-test test/v34/v01_layout.h --out-port src/v34/v34_object_layout.inc --out-probe test/v34/v01_layout_probe.cpp --port-header v34/v34_object.h
class tagV34Object size 0xac4c cxx V01_tagV34Object mirror V34Obj
  0x0000 i32 mode_    # V.34 modem mode: 1 / 2 = the V.90 / V.92 data modes (unsigned (mode - 1) < 2), 2 compared by InitiateRetrain, cleared by it
  0x0004 i32 state_    # VPcmV34Main state (v34handshakinit stores 6 / 7)
  0x0008 i32 w8_    # V04: INFODONE TONE_AB: 0x30 selects the echo start count 0x1e (else 0x96)
  0x000c u32 w0c_    # V06: VPcmV34Create clears it (obj+4+8)
  0x0010 u32 w10_    # V06: VPcmV34Create clears it (obj+4+0xc)
  0x0014 u32 rxWords_ 64    # V07: the 16-bit data words (bit 0 first) the handshake queues for the DTE side; VPcmV34Progress unpacks w114_ of them into the output bit array (a4) and clears w114_
  0x0114 u32 rxWordCnt_    # V06: obj+4+0x110, cleared by VPcmV34Create [RS22: was w114_; number of words in rxWords_ that VPcmV34Progress unpacks into the output bit array and clears [verified: layout doc]]
  0x0118 u32 txWords_ 64    # V07: the 16-bit words VPcmV34Progress packs from the input bit array (a6); consumed in [w21c_ (head), w218_ (tail))
  0x0218 u32 txTail_    # V06: obj+4+0x214, cleared by VPcmV34Create [RS22: was w218_; write index of txWords_ [verified: layout doc]]
  0x021c u32 txHead_    # V06: obj+4+0x218, cleared by VPcmV34Create [RS22: was w21c_; read index into txWords_ (consumed in [txHead_, txTail_)) [verified: layout doc + scrambler input]]
  0x0220 i32 minRateIdx_    # P->minRate_ / 2400, clamped to 14 by InitiateRetrain
  0x0224 i32 maxRateIdx_    # P->maxRate_ / 2400, raised to minRateIdx_, clamped to 14
  0x0228 i32 w228_    # V04: obj+4+0x224, stored with (short) waa98_ on the DATAXMIT entry
  0x022c i32 w22c_    # V04: obj+4+0x228, the same value
  0x0230 i32 minSigLevel_    # V34DisconnectThreshTable[(P->level_ + 0x30) > 7 ? 3 : ...]
  0x0234 i32 w234_    # cleared after the minSigLevel print
  0x0238 i32 sampleTime_    # V04: obj+4+0x234 (copied to w248_ on the DATAXMIT entry) [RS22: was w238_; running sample time: VPcmV34Progress adds the block length (& 0x7fffffff) [verified from the code]]
  0x023c u32 deadline_    # V04: obj+4+0x238: the status tail compares w238_ > w23c_ (unsigned) for the code 8 [RS22: was w23c_; sampleTime_ + 0x69780 set by v34handshakinit; sampleTime_ above it gives the status code 8 [verified from the code, MEDIUM for the name]]
  0x0240 i32 w240_    # V04: obj+4+0x23c: INFODONE (SILENCE) proceeds only when > 0x240 (signed)
  0x0244 u32 trainStartTime_    # V07: obj+4+0x240: the CAS-mask window start compared with w238_ by the mode-0 post-processing [RS22: was w244_; sampleTime_ at the start of the training: "Masking CAS detection after %d in train" prints sampleTime_ - trainStartTime_ [verified: string]]
  0x0248 i32 dataStartTime_    # V04: obj+4+0x244 [RS22: was w248_; sampleTime_ copied on the DATAXMIT entry; datapumpv34 measures the time in data mode from it [verified from the code]]
  0x024c i32 pcmMode_    # V.PCM / V.90 mode word (0 = plain V.34, 1 = V.90 retrain requested, 2 = after INFO1a, 3 / 0xb / 0xf set by the indications)
  0x0250 i32 k56Mode_    # K56Flex mode word (2 = enabled by the remote)
