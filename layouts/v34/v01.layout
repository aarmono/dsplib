  0xa9f2 u16 i1c16_=info1c_.w16_
  0xa9f4 u16 i1c18_=info1c_.w18_
  0xa9f6 u16 i1c1a_=info1c_.w1a_
  0xa9f8 u16 i1c1c_=info1c_.w1c_
  0xa9fa u16 i1c1e_=info1c_.w1e_
  0xa9fc u16 i1c20_=info1c_.w20_
  0xa9fe u16 i1c22_=info1c_.w22_
  0xaa00 u32 i1c24_=info1c_.d24_
  0xaa04 u16 i1c28_=info1c_.w28_
  0xaa06 u16 i1c2a_=info1c_.w2a_
  0xaa08 u32 i1c2c_=info1c_.d2c_
  0xaa0c unknown-region q2Unk00_=q2_.unk00_ 20    # V04: a third bit-queue record at +0xaa0c (0x30 B; cleared by TRNSEG4)
  0xaa20 u16 q214_=q2_.w14_
  0xaa22 u16 q216_=q2_.w16_
  0xaa24 u16 q218_=q2_.w18_
  0xaa26 u16 q21a_=q2_.w1a_
  0xaa28 u16 q21c_=q2_.w1c_
  0xaa2a u16 q21e_=q2_.w1e_
  0xaa2c u16 q220_=q2_.w20_
  0xaa2e u16 q222_=q2_.w22_
  0xaa30 u32 q224_=q2_.d24_
  0xaa34 u16 q228_=q2_.w28_
  0xaa36 u16 q22a_=q2_.w2a_
  0xaa38 u32 q22c_=q2_.d2c_
  0xaa3c unknown-region mpUnk00_=mpQ_.unk00_ 20    # V04: the MP bit-queue record at +0xaa3c (0x30 B; bitQ_ points at it during XMITMP; word 0 bit 0 = the far end MP was seen)
  0xaa50 u16 mp14_=mpQ_.w14_
  0xaa52 u16 mp16_=mpQ_.w16_
  0xaa54 u16 mp18_=mpQ_.w18_
  0xaa56 u16 mp1a_=mpQ_.w1a_
  0xaa58 u16 mp1c_=mpQ_.w1c_
  0xaa5a u16 mp1e_=mpQ_.w1e_
  0xaa5c u16 mp20_=mpQ_.w20_
  0xaa5e u16 mp22_=mpQ_.w22_
  0xaa60 u32 mp24_=mpQ_.d24_
  0xaa64 u16 mp28_=mpQ_.w28_
  0xaa66 u16 mp2a_=mpQ_.w2a_
  0xaa68 u32 mp2c_=mpQ_.d2c_
  0xaa6c ptr-into-heap bitQ_    # V04: pointer to the active bit-queue record (set to &info0a_ by SILENCEINFO)
  0xaa70 ptr-into-heap bitQ2_    # V04: pointer to the second bit-queue record (INFO0d)
  0xaa74 i32 waa74_    # V07: mode 8 (hold wait): the samples waited so far, compared (signed) with wabdc_
  0xaa78 u16 waa78_=hsSymCnt_    # V04: the echo-freeze countdown of JaTXMIT / K56JaTXMIT
  0xaa7a u16 wAa7a_=count3_    # V04: cleared on every SILENCE / SILENCEINFO / SILENCERETRAIN call
  0xaa7c u16 filtDelay_    # ((P->delay_ + 2) >> 2) + 0x22 ("V34 filtdelay")
  0xaa7e u16 waa7e_=bulkDelay_    # copied to two diagnostics words by VPcmV34GetDiagnostics (V03)
  0xaa80 u16 waa80_    # V04: TRNSEG4: set to 1
  0xaa82 unknown-region unkaa82_ 2
  0xaa84 u16 baud_    # symbol rate (0xc80 = 3200 in the short phase 2 branch)
  0xaa86 u16 period_    # printed as "period = %d" (movswl)
  0xaa88 u16 waa88_=txRateIdx_    # a rate index: * 2400 = a bit rate (VPcmV34GetDiagnostics) (V03)
  0xaa8a u16 preemp_    # pre-emphasis index
  0xaa8c unknown-region unkaa8c_ 4
  0xaa90 ptr-into-heap scalePtr_    # V04: TX_L1 (microstate): the scaling table of the baud rate (scale2400 .. scale3429)
  0xaa94 u16 carrier_    # carrier frequency (0x725 = 1829 in the short phase 2 branch)
  0xaa96 u16 waa96_=rxBaud_    # VPcmV34GetDiagnostics: copied to diagnostics +0xb4 (V03)
  0xaa98 u16 waa98_=rxRateIdx_    # a rate index: * 2400 = the receive bit rate (VPcmV34GetCurrentRxBitRate, VPcmV34GetDiagnostics) (V03)
  0xaa9a unknown-region unkaa9a_ 14
  0xaaa8 u16 waaa8_=rxCarrier_    # VPcmV34GetDiagnostics: copied to diagnostics +0xbc (V03)
  0xaaaa unknown-region unkaaaa_ 2
  0xaaac ptr-into-heap scaleTab_    # V04: TX_L1 (microstate): a copy of scalePtr_ (the table TRNSEG4A reads)
  0xaab0 ptr-into-heap detTab_    # V04: TRNSEG4: the table handed to detectorinit
  0xaab4 unknown-region unkaab4_ 28
  0xaad0 unknown-region fskState_ 8    # V04: the state record handed to fskdemodulate (address only)
  0xaad8 unknown-region unkaad8_ 4
  0xaadc u16 waadc_=fskCounter_    # V04: MOH_TONE: cleared
  0xaade u16 waade_=fskNextPoint_    # V04: DET_AB: set to 6
  0xaae0 u16 wAae0_=v21BitCnt_    # V04: RX_DPSK micro state word (cleared by the TX_PHASE2 error recovery)
  0xaae2 u16 wAae2_=v21RxBuf_    # V04: INFO0 receive flags (0xffff when armed; & 0xf == 0xf: complete)
  0xaae4 unknown-region unkaae4_ 202
  0xabae u16 wAbae_ 10    # V04: ten words cleared by the TX_PHASE2 error recovery
  0xabc2 u16 wAbc2_    # V04: cleared by the TX_PHASE2 error recovery
  0xabc4 u16 wabc4_    # V06: cleared by VPcmV34Create
  0xabc6 u16 wabc6_    # V06: cleared by VPcmV34Create, set to 1 by it in the V.92 session mode
  0xabc8 u16 wabc8_=info1dPending_    # V34GiveINFO1dBits: nonzero = the INFO1d request is in the INFO exchange (V03)
  0xabca u16 wabca_    # cleared by InitiateRetrain (isShort input of tier 2)
  0xabcc u16 shortPhase2_    # isShort (tier 2); cleared by InitiateRetrain
  0xabce u16 pair0_    # 2-bit values copied from the INFO1a bits 7:6 / 5:4 / 3:2 (tier 2); only the low two bits are tested here
  0xabd0 u16 pair1_    # 
  0xabd2 u16 pair2_    # 
  0xabd4 u16 wabd4_    # V06: cleared by VPcmV34Create; V.92 session mode: the V92Phase2Info byte +0x17
  0xabd6 unknown-region unkabd6_ 2
  0xabd8 u32 mohD8_    # cleared by VPcmV34InitMOH (V03)
  0xabdc u32 wabdc_    # V06: cleared by VPcmV34Create
  0xabe0 u16 mohE0_    # cleared by VPcmV34InitMOH
  0xabe2 u16 mohE2_    # cleared by VPcmV34InitMOH
  0xabe4 u16 mohE4_    # cleared by VPcmV34InitMOH
  0xabe6 u16 mohE6_    # cleared by VPcmV34InitMOH
  0xabe8 u8 mohE8_    # V04: SILENCERETRAIN: non-zero selects the MOH_TONE microstate
  0xabe9 u8 mohE9_    # VPcmV34InitMOH argument 2 (byte)
  0xabea unknown-region unkabea_ 2
  0xabec u32 mohEC_    # VPcmV34InitMOH argument 1
  0xabf0 u32 mohF0_    # VPcmV34InitMOH argument 1 (0 when it is 1)
  0xabf4 u32 mohF4_    # set to 5 by VPcmV34InitMOH
  0xabf8 u8 mohF8_    # V04: MOH_TONE_DROP: armed by the first tone-detect hit
  0xabf9 u8 mohF9_    # VPcmV34InitMOH argument 3 (byte; 0 when argument 1 is 1)
  0xabfa u8 mohFA_    # VPcmV34InitMOH argument 2 != 0
  0xabfb unknown-region unkabfb_ 1
  0xabfc u16 wabfc_    # V04: MOH_TONE: the symbol count limit of the tone wait (signed 16-bit compare)
  0xabfe u8 b_abfe_    # set to 1 by v90Phase34 when the "tx buffer backward clear" parameter bit is set
  0xabff u8 wAbff_    # V04: INFODONE (SILENCE) proceeds only when this signed byte is > 0
  0xac00 u8 b_ac00_    # set to 1 by InitiateRetrain for mode 0x5a when mode_ == 2
  0xac01 unknown-region unkac01_ 1
  0xac02 u16 wac02_=prevBulkDelay_    # V04: RX_PHASE1_ANS: the previous session bulk delay (short phase 2)
  0xac04 u32 dgC04_    # VPcmV34GetDiagnostics: copied to diagnostics +0xc0 (V03)
  0xac08 u32 dgC08_    # copied to diagnostics +0xc4
  0xac0c u16 dgC0c_    # diagnostics +0x228 (-1 when 0)
  0xac0e u16 dgC0e_    # added to dgC10_ -> diagnostics +0xec
  0xac10 u16 dgC10_
  0xac12 u16 dgC12_    # diagnostics +0xe8 / +0xf0 / +0x100
  0xac14 u16 dgC14_    # diagnostics +0xf4
  0xac16 u8 b_ac16_    # V06: cleared by VPcmV34Create
  0xac17 u8 b_ac17_    # V06: cleared by VPcmV34Create
  0xac18 ptr-into-heap k56_    # the K56Flex modem handle (K56FLEX_Create: uninitialised sysdep_malloc(0x14))
  0xac1c u16 rd0_=retrain_.w0_
  0xac1e u16 rd2_=retrain_.w2_
  0xac20 u16 rd4_=retrain_.w4_
  0xac22 u16 rd6_=retrain_.w6_
  0xac24 u32 rd8_=retrain_.w8_
  0xac28 u16 rdc_=retrain_.wc_
  0xac2a u16 rde_=retrain_.we_
  0xac2c u16 rd10_=retrain_.w10_
  0xac2e unknown-region retrainPad12_=retrain_.pad12_ 2
  0xac30 u32 rd14_=retrain_.w14_
  0xac34 u32 rd18_=retrain_.w18_
  0xac38 u32 rd1c_=retrain_.w1c_
  0xac3c ptr-into-heap params_    # P = dp_param_get(): the modem parameter block
  0xac40 u32 wac40_    # V07: requestOutputSampleClear record: 1
  0xac44 u32 wac44_    # V07: 2 * n (the number of samples asked clear)
  0xac48 u32 wac48_    # V07: 0

# the dp parameter block (src/core/dp_params.h _tagModemParameters, 0x88 B; this mirror is the 0x7c B prefix; `<mirror>=<member>` maps a mirror word to the member of the one flat struct); only the words the V.34 chain reads are named here
class _tagModemParameters size 0x7c cxx V01_ModemParams mirror V34ModParObj prefix 0x88
  0x00 u8 flags0_=flags0             # bit 0x10: K56Flex allowed, bit 0x08: V.90 allowed (VPcmV34InitiateRetrain's mode validation)
  0x01 unknown-region unk01_=flags1 1
  0x02 u8 flags2_=flags2             # bit 7 (sign bit): V34GiveINFO1dBits does not retrain to V.34 upstream when it is set (V03)
  0x03 u8 flags3_=flags3             # bit 0x04 cleared by v90RateRenegSilence, bit 4 of the V.90 rate-renegotiation flags
  0x04 unknown-region unk04_=w4 8
  0x0c i32 ansLevel_=ansLevel          # V06: printed as the ANSpcm level index by VPcmV34Create
  0x10 i32 uqtsIdx_=qcIndex           # V06: the Uqts index (VPcmV34Create prints it, hands it to enterChannelVerification as a short)
  0x14 u32 w14_=txMdTime               # V06: the desired TX MD time: VPcmV34Create stores 24 * it / 10 in wabfc_
  0x18 unknown-region unk18_=unk18 24
  0x30 u32 minRate_=minRate           # the rate limits InitiateRetrain hands to the (K56Flex / V.90) constellation designer and divides by 2400
  0x34 u32 maxRate_=maxRate
  0x38 u32 upMinRate_=upstreamMinRate         # Z01: vpcm_create stores 4800 (0x12c0; P07: upstreamMinRate)
  0x3c u32 upMaxRate_=upstreamMaxRate         # Z01: vpcm_create stores 33600 (0x8340; P07: upstreamMaxRate)
  0x40 unknown-region unk40_=powerReduction 8
  0x48 u32 connType_=connectionType          # Z01: vpcm_delete copies it to word 0 of the pair modem_get_param(modem, 0xb) returns (P07: connectionType)
  0x4c u32 regWord_=clockDeviation           # Z01: ... and this one to word 1 (P07: the unnamed word unk4c)
  0x50 u8 flags50_=flags50            # bit 0x08 set when the sensitive-ISP flag is seen; bit 0x04 = tx buffer backward clear (v90Phase34)
  0x51 u8 b51_=flags51                # V07: bit 0 set by VPcmV34Progress with the requestOutputSampleClear
  0x52 unknown-region unk52_=unk52 2
  0x54 i32 w54_=codecType               # V06: == 0xe selects the entrance filter (VPcmV34Create, mode according to HW)
  0x58 unknown-region unk58_=w58 8
  0x60 i32 level_=minLevel             # minimum signal level request
  0x64 i32 delay_=delay             # initial delay (V34 filtdelay)
  0x68 i32 extDelay_=extDelay          # external delay (V34dmadelay / echo delay)
  0x6c u32 w6c_=p2Silence               # V07: the silence added on PHASE2_COMPLETE (printed)
  0x70 i32 entrFilt_=entranceFilter          # V06: entrance filter mode of VPcmV34Create: -1 = according to the hardware (w54_ == 0xe), 1 = forced enabled, else forced disabled
  0x74 unknown-region unk74_=unk74 4
  0x78 u32 w78_=path          # Z01: vpcm_create clears it.  EOS: the class member is `path` (a char * of the dp parameter block, 8 bytes on x86-64); the mirror and the recorded dumps keep the u32 `w78_` (the low 32 bits) so that the size and the log of the 64-bit harness do not move

# the K56Flex handle: K56FLEX_Create = sysdep_malloc(0x14), never initialised (the K56FlexFloModem class has no data members); the V.34 code reads a byte and a word of it
class K56FlexHandle size 0x14 cxx V01_K56Handle mirror K56HandleObj
  0x00 u32 word0_             # VPcmV34GetCurrentRxBitRate returns it in mode 3 (V03)
  0x04 unknown-region unk04_ 4
  0x08 u8 flag8_
  0x09 unknown-region unk09_ 3
  0x0c i32 word_c_
  0x10 unknown-region unk10_ 4
