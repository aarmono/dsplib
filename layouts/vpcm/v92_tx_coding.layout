# The FloatFIR / FloatIIR sub-objects are plain (normalised) pointers on purpose: the blocks they point to are FloatFIR / FloatIIR OBJECTS (0x14 B on i386, they hold pointers), which
# the harness dumps field-wise with the P02 tables (a raw hex dump of the block would contain raw pointers).
# V92ConvolutionEncoder: heap block of V92Transmitter (sysdep_malloc(0x2008), constructor `ret`)
class V92ConvolutionEncoder size 0x2008 cxx P16_V92ConvolutionEncoder mirror ConvObj
  0x0000 i32 mode_            # reset(mode): 0 = 16 states, 1 = 32 states, 2 = 64 states (anything else: no table, process undefined)
  0x0004 i32 state_           # current trellis state
  0x0008 i32 out_ 1024        # out_[(state << 4) + input]: coded bit, indexed by the NEW state (see makeStateTtransitionTable)
  0x1008 i32 next_ 1024       # next_[(state << 4) + input]: next state
# V92PreFilter: heap block of V92Transmitter (sysdep_malloc(0x14))
class V92PreFilter size 0x14 cxx P16_V92PreFilter mirror PfObj
  0x00 unknown-region unk0_ 4 # never touched
  0x04 ptr-into-heap fir_     # heap FloatFIR (0x14 B on i386): sysdep_malloc + FloatFIR(ntaps, NULL, 99) in the ctor, D1 + sysdep_free in the dtor
  0x08 ptr-into-heap iir_     # heap FloatIIR
  0x0c u32 nFir_              # setCoefficients' tap counts: a stage with 0 taps is skipped by process
  0x10 u32 nIir_
# V92Precoder: heap block of V92Transmitter (sysdep_malloc(0x80))
class V92Precoder size 0x80 cxx P16_V92Precoder mirror PcObj
