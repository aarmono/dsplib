  0x08 ptr-into-heap lcp_ 6   # reset(p): p->lcp_[0..5] (borrowed: the constellation tables of 0x200 B)
  0x20 i32 m_ 12              # reset(p): p->m_[0..11] (the radices)
  0x50 i32 lc_ 6              # reset(p): p->lc_[0..5]
  0x68 ptr-into-heap fir1_    # heap FloatFIR (filters the chosen constellation value)
  0x6c ptr-into-heap fir2_    # heap FloatFIR (filters the chosen sum)
