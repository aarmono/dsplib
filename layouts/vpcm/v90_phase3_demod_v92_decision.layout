  0x0008 u32 session_              # C1 arg 3 / setSessionFlag: nonzero = V.92 session (getDecision calls getV92Decision)
  0x000c ptr-into-heap params_     # C1 arg 1 (V90Parameters *)
  0x0010 u32 pcm_                  # reset arg 1 (PcmType): 0 = mu-law, nonzero = A-law
  0x0014 u32 timeBase_             # reset arg 11: the time-out base of the Sd / Jd states
  0x0018 u8 code_                  # reset arg 2: the G.711 code of the reference level
  0x0019 unknown-region pad19_ 1   # never touched
  0x001a u16 level_                # linear value of code_ (signed): the decision level compared with |modulator symbol|
