# V92Phase4Modulator: the V.92 phase-4 (TX, "u" = upstream-direction names: Ru / E1u / E2u / B1u / TRN2u / SUVu / CPu / Rm) symbol generator, 0x1cc bytes on i386, a plain class (no vptr); V92Modulator embeds it.
# A Scrambler<uchar,uchar> is embedded at +0x4c (flattened here as scr_*).  The objects it USES (V92Parameters, V92BitsToSymbol, V92CP, V92MappingParams) are plain pointers; the V92Mapper (0x2c bytes) is allocated by the constructor.
# Member names are descriptive (the vendor's are unknown); the states come from the debug strings ("enter E1u / E2u / B1u / FB1u / Ru / Rm", "RRN: ...", "FPE: enter SUVu", "CPu Terminated").
class V92Phase4Modulator size 0x1cc cxx P32_V92Phase4Modulator mirror V92Ph4Obj
  0x0000 u32 state_                # V92Phase4ModulatorState (generateSymbol dispatches on it: 0 .. 0x1d)
  0x0004 u32 cnt_                  # symbols since the state began (incremented BEFORE the dispatch)
  0x0008 u32 w08_                  # cleared at every SUV (re)start; read / written by generateSUVu / generateCPu
  0x000c u32 event_                # output marker of the symbol just generated (0 none, 9 = Phase4 terminated)
  0x0010 unknown-region pad10_ 8   # never touched
  0x0018 u32 cpCnt_                # symbols while the repeated-CPu flag is set (state 5)
  0x001c u8 cpFlag_                # state 5: count cpCnt_
  0x001d unknown-region pad1d_ 3   # never touched
  0x0020 u32 w20_                  # flags of the RRN part (written by reset, resetBeforRRN, recived*)
  0x0024 u32 w24_                  # state 0x17: the minimum count of the TRN2u second part (0x1f44 / 0xfa0, set at the end of E2u)
  0x0028 u32 w28_                  # state 0xf (E2u) end: with w30_ != 0 and w34_ == 0 -> TRN2u second part at RRN
  0x002c u32 w2c_=rrnSilence_                  # the SUV value handed to V92CP::setSUV
  0x0030 u32 w30_
  0x0034 u32 w34_
  0x0038 u32 w38_                  # selects the length of the TRN2u second part (0x1f44 if zero, else 0xfa0)
  0x003c u32 w3c_                  # FPE flag: nonzero = the E2u / B1u data come from the BitsToSymbol queue (state 0xf -> FB1u 0x11)
  0x0040 u16 level_                # reset arg 1 (short): the Ru / RuNot amplitude
  0x0042 u8 b42_                   # reset arg 2 (u8)
  0x0043 u8 mult_                  # reset arg 2 + 2: scrambled bits per symbol group (the V92Mapper input length; the CP's +0x128)
  0x0044 u32 limit_                # reset arg 5: state 5 stops counting at limit_ + 0x320
  0x0048 ptr-into-heap mp_         # V92MappingParams * (constructor arg 4)
