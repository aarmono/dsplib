# P46 layout (32-bit, measured from the blob): VPcmFloModem, 0x7f68 bytes (VPCMXF_Create: sysdep_malloc(0x7f68) + VPcmFloModem::VPcmFloModem).  P46 = v90RunDemodulator + runPcmModem; the constructor / destructor and the
# other 26 methods are P47's.  KNOWN here = every member those two functions touch (named, with the access widths of the disassembly; `member_map.py blob --class VPcmFloModem --func 'v90RunDemodulator|runPcmModem'`) and every
# member the constructor stores (the C1 stores the P47 fills in, porting/decompiled/dp/p46_vpcmflo_a.txt).  UNKNOWN (named unknown regions, for P47 to fill): the TX / RX frame buffers, the ANSam detector / sine generator
# block, the CP frame buffer, the 0x7dd8 .. 0x7f5b tail (GenericIIR<float,double> at 0x7f28 ...).  The embedded sub-objects reuse the P45 / P22 layouts at their offsets: V90Modem at +0x1758 (0x49c0), V92Modem at +0x6124
# (0xaac), V92EchoCanceller at +0x6bd0 (0x3c), tagV90DILdescriptor at +4 (0x213).  Their members are FLATTENED (`name=sub.member`), pointer-holding sub-objects between `align8` markers (x86-64 pads them to pointer
# alignment: P45 / P28 convention).  ALL pointers are `ptr-into-heap` (normalised by the dump, never dumped through).
# RS1 / M1 (2026-10-06): the port's own P46 header (dsp_classes_p46.h + dsp_layout_p46.inc, deleted in RS1) is gone; src/vpcm/vpcm_flo_modem_run.cpp compiles against the ONE definition, src/vpcm/vpcm_flo_modem.h.  This
# file stays the P46 harness' mirror (PcmFloObj, member names unchanged, so the dumps / goldens are unchanged): the probe now checks it against P47_VPcmFloModem (`mirror=port` aliases for the six
# members P47 renamed and for unk7dd8_ = uinfoA_), and two pad64 markers make the x86-64 mirror follow P47's x86-64 layout (the ANSam / GenericIIR pointers inside ansam_ / iir_).  i386: unchanged.
# regenerate: tools/layout_gen.py layouts/vpcm/vpcm_flo_modem_run.layout --chunk p46 --port-header vpcm/vpcm_flo_modem.h
class VPcmFloModem size 0x7f68 cxx P47_VPcmFloModem mirror PcmFloObj
  0x0000 ptr-into-heap ctx_              # the V.34 module context (C1 arg 1, borrowed): the first argument of every VPcmV34* / V34XF_* call
  0x0004 unknown-region dil_ 0x213       # tagV90DILdescriptor (P13), handed to the V90Modem / V92Modem constructors; not touched by P46
  0x0217 u8 v34Flags_ 6                  # "drop to V34" sets 1,0,1,1,1,1 (state 0x1f of the demodulator)
  0x021d u8 pad21d_
  0x021e unknown-region cpnotFrame_ 0x1518   # V90CPPacker output (CP / CPnot on MP receive: `short *`); P46 only passes its address
  0x1736 u16 cpnotLen_                   # V90CPPacker result (low 16 bits) of the CPnot built on MP / MPnot receive
  0x1738 u16 w1738_=bitPtr_                   # cleared by the CP / CPt / CPnot-complete states
  0x173a u8 trainConstel_                # V90Jd / V92Jd::getConstelationSize first output
  0x173b u8 rrnConstel_                  # second output (0 = 4 points / 1 = 16 points)
  0x173c u8 localRrn_                    # set by the rate-renegotiation request, cleared by the next one
  0x173d u8 dropToV34_                   # set by the "drop to V34 requested" states
  0x173e u8 clearDown_                   # the CP "clr" bit / the cleardown request
  0x173f u8 pad173f_
  0x1740 u32 w1740_=constelCtr_                   # stored by the constructor, not touched by P46
  0x1744 u8 mpB_ 6                       # the MP information copy (V90MP type_ .. cPack_ bytes) the V.34 module reads at ctx+0x1744 .. 0x1757 (getMPrecvdBits)
  0x174a u16 mpRate2_                    # 2 * (short)V90MP::rateMask_
  0x174c u16 mpH_ 6                      # V90MP::h1Re_ .. h3Im_
