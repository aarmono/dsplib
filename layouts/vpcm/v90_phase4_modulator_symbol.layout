# V90Phase4Modulator: the V.90 phase-4 (TX) symbol generator, 0x2fac bytes on i386, a plain class (no vptr); V90Modulator embeds it.  A Scrambler<uchar,uchar> is embedded at +0x58 (flattened here as scr_*; its history block is a heap block).
# The objects it USES (V90BitsToSymbol, V90MP, two V90MappingParams, V90CP, V90Parameters) are plain pointers; the constructor allocates the V90BitsToSymbol itself when none is passed (the owner flag at +0x2fa4).
# Member names are descriptive (the vendor's are unknown); the states come from the debug strings ("enter RiNot", "enter TRN2d", "enter MP", "enter Ed", "enter B1d", "Phase4 Terminated", the V.92 SUVd / CPd family).
class V90Phase4Modulator size 0x2fac cxx P30_V90Phase4Modulator mirror Ph4Obj
  0x0000 u32 flag_                 # C1 arg 2 / setSessionFlag: nonzero = V.92 session (generateSymbol calls generateV92Symbol)
  0x0004 u32 state_                # Phase4ModulatorState
  0x0008 u32 cnt_                  # symbols since the state began (incremented BEFORE the dispatch)
  0x000c u32 event_                # output marker of the symbol just generated (0 none, 4 = TRN2d ended in V.92, 7 = Phase4 terminated)
  0x0010 u32 nextState_            # reset: flag_ == 0 ? 4 : 5; V.90: the state entered after TRN2d (4 = "MP", else "DIRECTLY to MPNot"); setNextStateAfterTRN2d
  0x0014 u8 mpNotSeen_             # V.90 state 0xe: set by recivedCP-family, cleared by generateV90Symbol
  0x0015 unknown-region pad15_ 3   # never touched
  0x0018 u32 cpCnt_                # V.92: symbols while the repeated-CPd flag is set (state 5)
  0x001c u8 cpFlag_                # V.92 state 5: count cpCnt_
  0x001d unknown-region pad1d_ 3   # never touched
  0x0020 u32 w20_                  # V.92 flags / counters of the RRN part (written by reset, resetBeforRRN, recived*)
  0x0024 u32 w24_
  0x0028 u32 w28_                  # copied to the CP's word at +0xca0 when a CP / SUVd starts
  0x002c u32 w2c_
  0x0030 u32 w30_
  0x0034 u32 w34_                  # V.92 state 0x10: silence goes to state 0x18 when zero, else 0x17
  0x0038 u32 pcm_                  # reset arg 1 (PcmType): handed to resetNoSpectral
  0x003c u16 level_                # linear value of reset arg 2 (a G.711 code, sign dropped): the Ri / RiNot amplitude
