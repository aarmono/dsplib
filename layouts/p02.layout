class FloatFIR size 0x14 cxx P02_FloatFIR mirror FirObj
  0x00 ptr-into-heap coef_       # borrowed coefficient array (arg 2 of the ctor), never freed
  0x04 ptr-to-heap hist_         # histLen_ floats
  0x08 u32 taps_                 # ntaps & ~3
  0x0c u32 histLen_              # taps_ + extra
  0x10 i32 room_                 # write / read index, counts DOWN

