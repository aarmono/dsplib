class FloatARMA size 0x34 cxx P02_FloatARMA mirror ArmaObj
  0x00 ptr-to-heap ar_           # nAr4_ floats: copy of the AR coefficients, divided by ar[0], [0] = 0
  0x04 ptr-to-heap ma_           # nMa4_ floats: copy of the MA coefficients, divided by ar[0]
  0x08 ptr-to-heap xhist_        # xlen_ floats (input history)
  0x0c ptr-to-heap yhist_        # ylen_ floats (output history)
  0x10 u32 nAr4_
  0x14 u32 nMa4_
  0x18 u32 xlen_
  0x1c u32 ylen_
  0x20 i32 xr_
  0x24 i32 yr_
  0x28 u32 idx_                  # loop counter of the blob's ctor / reset kept in a member
  0x2c float32 y_
  0x30 float32 w_

